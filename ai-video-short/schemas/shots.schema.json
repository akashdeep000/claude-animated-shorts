{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mromidev/claude-animated-shorts/ai-video-short/schemas/shots.schema.json",
  "title": "shots.json",
  "description": "The shot plan and EDL. Produced by S3 from timing.json. Assembly makes no timing decisions of its own.",
  "type": "object",
  "required": ["narrationDurationSec", "fps", "size", "shots"],
  "additionalProperties": false,
  "properties": {
    "narrationDurationSec": { "type": "number", "exclusiveMinimum": 0 },
    "fps": { "type": "integer", "const": 24 },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "const": 720 },
        "height": { "type": "integer", "const": 1280 }
      }
    },
    "constants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetSec": { "type": "number", "default": 4.8 },
        "minSec": { "type": "number", "default": 4.0 },
        "maxSec": { "type": "number", "default": 5.6 },
        "nativeSec": { "type": "number", "const": 5.208333 },
        "extendSec": { "type": "number", "const": 4.0 },
        "tailSec": { "type": "number", "default": 0.4 },
        "stretchMax": { "type": "number", "default": 1.12 }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shotId", "index", "beat", "text", "startSec", "endSec",
          "ownedSec", "generatedSec", "cast", "location", "motionClass",
          "transitionIn", "keyframe", "video"
        ],
        "additionalProperties": false,
        "properties": {
          "shotId": { "type": "string", "pattern": "^S[0-9]{2,3}$" },
          "index": { "type": "integer", "minimum": 1 },
          "segmentIds": { "type": "array", "items": { "type": "string" } },
          "beat": { "type": "string" },
          "text": {
            "type": "string",
            "description": "Exact narration covered by this shot, concatenated from timeline.json words."
          },
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "minimum": 0 },
          "ownedSec": {
            "type": "number",
            "description": "Narration time this shot owns. sum(ownedSec) == narrationDurationSec."
          },
          "generatedSec": {
            "type": "number",
            "description": "5.208333 native, or n extends. Must be >= ownedSec + transitions."
          },
          "cast": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
          "location": { "type": "string" },
          "motionClass": { "enum": ["creep", "orbit", "parallax", "impact", "sway"] },
          "transitionIn": { "enum": ["cut", "dissolve", "flash", "cut-shake"] },
          "continuity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": { "enum": ["sheet", "chain", "b-shot"] },
              "fromShot": { "type": "string" }
            }
          },
          "keyframe": {
            "type": "object",
            "required": ["file", "promptFile", "crop"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "promptFile": { "type": "string" },
              "promptSha": { "type": "string" },
              "crop": { "enum": ["top", "center", "bottom"], "default": "center" },
              "refs": { "type": "array", "items": { "type": "string" } },
              "attempts": { "type": "integer", "minimum": 0 }
            }
          },
          "video": {
            "type": "object",
            "required": ["file", "promptFile"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "promptFile": { "type": "string" },
              "promptSha": { "type": "string" },
              "attempts": { "type": "integer", "minimum": 0 },
              "policyHits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "attempt": { "type": "integer" },
                    "code": { "type": "string" }
                  }
                }
              },
              "driftSsim": { "type": "number", "minimum": 0, "maximum": 1 },
              "motionScore": { "type": "number", "minimum": 0 }
            }
          },
          "lifePass": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
